# Copy to .env (or run `npm run db:setup` from the repo root, which writes .env for you).
# .env is never committed.

# Local PostgreSQL, using the `wechiau` user created by infra/dev-db.sql.
DATABASE_URL="postgresql://wechiau:CHANGE_ME@localhost:5432/wechiau_dev?schema=public"
TEST_DATABASE_URL="postgresql://wechiau:CHANGE_ME@localhost:5432/wechiau_test?schema=public"

PORT=3000
# 0.0.0.0 lets phones on the same Wi-Fi reach the server during development.
# On the VPS use 127.0.0.1 (Caddy sits in front).
HOST=0.0.0.0

# Uploaded files (visit photos). On the VPS use a folder outside the app, for
# example /var/lib/wechiau/uploads, and back it up with the database.
UPLOADS_DIR=uploads
