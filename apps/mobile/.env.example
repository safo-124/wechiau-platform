# Copy to .env.local. Expo reads EXPO_PUBLIC_* variables when it bundles the app.
#
# On a real phone, use your laptop's Wi-Fi address (run `ipconfig` and look for
# the IPv4 address), and start the server with HOST=0.0.0.0. The phone and the
# laptop must be on the same Wi-Fi.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api

# To try the apps against the VPS instead of the laptop:
# EXPO_PUBLIC_API_URL=https://wechiau.135.181.93.156.nip.io/api
# Installable apps built with EAS get this address from eas.json.
