{
  "name": "@wechiau/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Schemas, types, permissions map and money helpers shared by the apps, dashboard and server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/test-fixtures.d.ts",
      "default": "./dist/test-fixtures.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^4.1.2"
  }
}
